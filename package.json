{
  "name": "motif-monorepo",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "workspaces": [
    "packages/*",
    "ui"
  ],
  "scripts": {
    "build": "npm run build -w @motif/ui && npm run build -w getmotif",
    "test": "vitest run",
    "typecheck": "tsc -b packages/core packages/cli packages/server",
    "bench": "tsx bench/run.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^22.10.0",
    "prettier": "^3.9.6",
    "tsup": "^8.3.5",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  },
  "engines": {
    "node": ">=22"
  },
  "license": "Apache-2.0"
}
