  "homepage": "https://github.com/motif-Labs/motif#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/motif-Labs/motif.git"
  },
  "bugs": {
    "url": "https://github.com/motif-Labs/motif/issues"
  },
  "type": "module",
  "bin": {
    "motif": "dist/index.js"
  },
  "files": [
    "dist",
    "LICENSE",
    "NOTICE",
    "README.md"
  ],
  "scripts": {
    "build": "tsup && node scripts/copy-ui.mjs",
    "dev": "tsx src/index.ts"
  },
  "dependencies": {
